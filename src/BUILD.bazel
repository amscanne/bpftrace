        "bpfmap.cpp",
        "bpfprogram.cpp",
        "bpftrace.cpp",
        "btf.cpp",
        "child.cpp",
        "config.cpp",
        "disasm.cpp",
        "dwarf_parser.cpp",
        "format_string.cpp",
        "globalvars.cpp",
        "ksyms.cpp",
        "log.cpp",
        "output.cpp",
        "pcap_writer.cpp",
        "printf.cpp",
        "probe_matcher.cpp",
        "probe_types.cpp",
        "procmon.cpp",
        "run_bpftrace.cpp",
        "usdt.cpp",
        "usyms.cpp",
    ],
    hdrs = [
        "async_action.h",
        "attached_probe.h",
        "bfd-disasm.h",
        "bpf_assembler.h",
        "bpfbytecode.h",
        "bpffeature.h",
        "bpfmap.h",
        "bpfprogram.h",
        "bpftrace.h",
        "btf.h",
        "child.h",
        "config.h",
        "config_parser.h",
        "disasm.h",
        "dwarf_parser.h",
        "format_string.h",
        "globalvars.h",
        "kfuncs.h",
        "ksyms.h",
        "log.h",
