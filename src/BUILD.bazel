load("//:build_defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Parser library (flex + bison outputs)
cc_library(
    name = "parser",
    srcs = [
        "//:bison_parser",
        "//:flex_lexer",
    ],
    hdrs = ["//:bison_parser"],
    copts = ["-w"],  # Disable warnings for generated code
    includes = [
        ".",
        "ast",
    ],
)

# Core libraries
cc_library(
    name = "required_resources",
    srcs = ["required_resources.cpp"],
    hdrs = ["required_resources.h"],
    includes = ["."],
    deps = [":parser"],
)

cc_library(
    name = "compiler_core",
    srcs = [
        "functions.cpp",
        "struct.cpp",
        "types.cpp",
    ],
    hdrs = [
        "functions.h",
        "struct.h",
        "types.h",
    ],
    includes = ["."],
    deps = [":parser"],
)

cc_library(
    name = "runtime",
    srcs = [
        "async_action.cpp",
        "attached_probe.cpp",
        "bfd-disasm.cpp",
        "bpfbytecode.cpp",
